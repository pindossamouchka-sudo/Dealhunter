# Telegram Bot
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username

# Telethon (MTProto)
API_ID=123456
API_HASH=your_api_hash_here
STRING_SESSION=your_string_session_here

# Database
DATABASE_PATH=./data/namehunter.db

# WebApp
WEBAPP_URL=https://your-domain.com
WEBAPP_PUBLIC_URL=https://your-domain.com

# Security
SECRET_KEY=your_super_secret_key_min_32_chars_here
INIT_DATA_TTL=86400

# Fragment / TON
TON_API_KEY=your_ton_api_key
FRAGMENT_API_URL=https://fragment.com/api

# Redis (optional, for rate limiting)
REDIS_URL=redis://localhost:6379/0

# Monitoring
SENTRY_DSN=

# Feature Flags
ENABLE_QUANTUM_INTERCEPT=false
ENABLE_GALACTIC_RAID=false
ENABLE_TIME_CAPSULE=false